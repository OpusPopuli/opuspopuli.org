---
import Sunflower from './Sunflower.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/tools', label: 'Tools' },
  { href: '/about', label: 'About' },
  { href: '/why', label: 'Why' },
  { href: '/network', label: 'Network' },
  { href: '/open-source', label: 'Open Source' },
];

// Keep in sync with the California entry in src/pages/network.astro.
const signInUrl = 'https://california.opuspopuli.org/';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 bg-paper border-b border-border">
  <nav class="container mx-auto px-6 py-4 max-w-5xl">
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group" aria-label="Opus Populi — home">
        <Sunflower state="idle" size={34} />
        <span class="flex flex-col leading-none">
          <span class="text-sm font-semibold tracking-[0.18em] uppercase text-ink">Opus Populi</span>
          <span class="font-display italic text-xs text-dim mt-1">The Work of the People</span>
        </span>
      </a>

      <div class="hidden md:flex items-center gap-6">
        <ul class="flex items-center gap-6">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'text-sm transition-colors',
                  isActive(link.href)
                    ? 'text-ink font-semibold border-b-2 border-gold pb-0.5'
                    : 'text-ink/60 hover:text-ink border-b-2 border-transparent pb-0.5',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        {/*
          Names the region deliberately. This is the NETWORK site, and
          networkMembers in src/pages/network.astro is a list built to grow --
          a bare "Sign In" quietly sends every visitor to one particular node,
          which reads fine with one member and misleads the moment there are
          two. Spelled out rather than "CA" to match how the node is named on
          the network page, and because a state code is not obvious to a
          first-time visitor from elsewhere.
        */}
        <a
          href={signInUrl}
          class="inline-flex items-center bg-gold text-ink font-semibold px-4 py-2 rounded-lg hover:brightness-95 transition-[filter] text-sm"
        >
          Sign In — California
        </a>
      </div>

      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-ink/70"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden md:hidden mt-6 pb-4 border-t border-border pt-6 max-h-[calc(100dvh-var(--header-height))] overflow-y-auto">
      <ul class="flex flex-col gap-4">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'block text-sm transition-colors',
                isActive(link.href)
                  ? 'text-ink font-semibold border-l-2 border-gold pl-3'
                  : 'text-ink/60 hover:text-ink border-l-2 border-transparent pl-3',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      {/* Mobile. Keep the label identical to the desktop button above. */}
      <a
        href={signInUrl}
        class="mt-6 inline-flex items-center justify-center w-full bg-gold text-ink font-semibold px-4 py-2.5 rounded-lg hover:brightness-95 transition-[filter] text-sm"
      >
        Sign In — California
      </a>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
  });
</script>
